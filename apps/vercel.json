
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "src-tauri": {
      "root": "mobile/src-tauri",
      "framework": "tauri",
      "runtime": "rust"
    },
    "api": {
      "root": "api",
      "framework": "nestjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@ftms/api",
      "functions": {
        "api/index.js": {
          "includeFiles": "{dist/**,assets/**,../../node_modules/.pnpm/pdfkit@*/node_modules/pdfkit/js/standard-fonts/**}",
          "maxDuration": 30
        }
      }
    },
    "web": {
      "root": "web",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@ftms/web",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
