{
  "name": "@ftms/api",
  "version": "0.0.0",
  "private": true,
  "description": "FTMS NestJS API — the single source of business rules for web and the future mobile client.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.ts --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "storage:provision": "nest build && node dist/scripts/provision-storage.js",
    "mail:verify": "nest build && node dist/scripts/verify-smtp.js",
    "seed:super-admin": "nest build && node dist/scripts/seed-super-admin.js",
    "cron:install": "nest build && node dist/scripts/install-cron.js"
  },
  "dependencies": {
    "@ftms/core": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "4.9.0",
    "@simplewebauthn/server": "14.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.10.1",
    "exceljs": "4.4.0",
    "nodemailer": "^10.1.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ftms/eslint-config": "workspace:*",
    "@nestjs/cli": "^12.0.9",
    "@nestjs/schematics": "^12.0.9",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "pdfjs-dist": "6.2.108",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
