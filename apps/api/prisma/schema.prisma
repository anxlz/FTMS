// FTMS database schema — Supabase Postgres via Prisma ORM.
//
// Phase 1: identity, authorization and audit foundation (§16).
// Phase 2: student records, training groups and memberships, spreadsheet
// imports, account-verification and profile-change requests.
// Phase 3: training program settings, recurring schedules and exceptions,
// visits with their groups and files, in-app notifications.
// Phase 4: attendance records, biometric (WebAuthn) credentials and challenges,
// check-in policy, absence processing.
// Later feature entities (visits, attendance, tickets, swaps, …) arrive with the
// phase that implements them, each through its own migration.
//
// Constraints Prisma cannot express (lowercase-email CHECKs, the append-only
// audit trigger, Row Level Security) live in the migration SQL and are covered
// by the database structure tests in `apps/api/test/database.e2e-spec.ts`.
//
// Connection URLs are not declared here: the CLI reads `prisma.config.ts`, the
// runtime passes the URL to the driver adapter in `src/prisma/prisma.service.ts`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  TRAINING_DIRECTOR
  FACULTY
  STUDENT
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum Locale {
  ar
  en
}

/// One login identity. `email` is stored normalized (trimmed, lowercase).
model User {
  id                 String        @id @default(uuid(7)) @db.Uuid
  email              String        @unique @db.VarChar(254)
  role               Role
  status             AccountStatus @default(ACTIVE)
  displayName        String        @map("display_name") @db.VarChar(200)
  /// argon2id hash. NULL until the account sets a password (first login by email code).
  passwordHash       String?       @map("password_hash")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?     @map("password_changed_at") @db.Timestamptz(3)
  emailVerifiedAt    DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  preferredLocale    Locale        @default(ar) @map("preferred_locale")
  lastLoginAt        DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdById        String?       @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy      User?                 @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers   User[]                @relation("UserCreatedBy")
  studentProfile StudentProfile?       @relation("StudentAccount")
  facultyProfile FacultyProfile?
  sessions       AuthSession[]
  challenges     AuthChallenge[]
  grants         UserPermissionGrant[] @relation("GrantSubject")
  grantsGiven    UserPermissionGrant[] @relation("GrantGrantor")

  studentsCreated         StudentProfile[]             @relation("StudentCreatedBy")
  groupsCreated           TrainingGroup[]              @relation("GroupCreatedBy")
  membershipsAssigned     GroupMembership[]            @relation("MembershipAssignedBy")
  membershipsEnded        GroupMembership[]            @relation("MembershipEndedBy")
  importsCreated          StudentImport[]              @relation("ImportCreatedBy")
  importsCommitted        StudentImport[]              @relation("ImportCommittedBy")
  verificationRequests    StudentVerificationRequest[] @relation("VerificationAccount")
  verificationsDecided    StudentVerificationRequest[] @relation("VerificationDecidedBy")
  profileChangesRequested ProfileChangeRequest[]       @relation("ProfileChangeRequestedBy")
  profileChangesDecided   ProfileChangeRequest[]       @relation("ProfileChangeDecidedBy")

  programsCreated   TrainingProgram[]   @relation("ProgramCreatedBy")
  schedulesCreated  TrainingSchedule[]  @relation("ScheduleCreatedBy")
  schedulesEnded    TrainingSchedule[]  @relation("ScheduleEndedBy")
  exceptionsCreated ScheduleException[] @relation("ExceptionCreatedBy")
  visitsCreated     TrainingVisit[]     @relation("VisitCreatedBy")
  visitsUpdated     TrainingVisit[]     @relation("VisitUpdatedBy")
  visitsCancelled   TrainingVisit[]     @relation("VisitCancelledBy")
  visitFiles        VisitFile[]         @relation("VisitFileUploadedBy")
  notifications     Notification[]      @relation("NotificationRecipient")

  webauthnCredentials WebAuthnCredential[] @relation("CredentialOwner")
  credentialsRevoked  WebAuthnCredential[] @relation("CredentialRevokedBy")
  webauthnChallenges  WebAuthnChallenge[]
  attendanceCorrected AttendanceRecord[]   @relation("AttendanceCorrectedBy")

  @@index([role, status])
  @@map("users")
}

/// Authoritative academic record of a student (§4.1). Exists before any account:
/// faculty import or create it; `userId` is set when the student's account is
/// linked (§4.2 Case A, §4.3 first login, or an approved verification request).
model StudentProfile {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String?   @unique @map("user_id") @db.Uuid
  /// Normalized (trimmed, uppercase, Western digits).
  seatNumber      String    @unique @map("seat_number") @db.VarChar(20)
  fullName        String    @map("full_name") @db.VarChar(200)
  firstName       String?   @map("first_name") @db.VarChar(60)
  fatherName      String?   @map("father_name") @db.VarChar(60)
  grandfatherName String?   @map("grandfather_name") @db.VarChar(60)
  familyName      String?   @map("family_name") @db.VarChar(60)
  /// University email on the record (may be missing, §4.1). Normalized lowercase.
  universityEmail String?   @unique @map("university_email") @db.VarChar(254)
  /// Self-service field (§4.4): the student may change it directly.
  phone           String?   @db.VarChar(20)
  /// Search key derived from `fullName` by a database trigger (spelling variants,
  /// diacritics and spacing removed, see `ftms_name_key`). Never written by the app.
  nameKey         String    @default("") @map("name_key") @db.VarChar(200)
  linkedAt        DateTime? @map("linked_at") @db.Timestamptz(3)
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User?                        @relation("StudentAccount", fields: [userId], references: [id], onDelete: Restrict)
  createdBy           User?                        @relation("StudentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships         GroupMembership[]
  profileChanges      ProfileChangeRequest[]
  verificationsLinked StudentVerificationRequest[]
  attendance          AttendanceRecord[]

  @@index([fullName])
  @@index([nameKey])
  @@map("student_profiles")
}

model FacultyProfile {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(200)
  academicTitle String?  @map("academic_title") @db.VarChar(100)
  department    String?  @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("faculty_profiles")
}

/// Permission catalog — mirrors `PERMISSIONS` in @ftms/core (kept in sync by a test).
model Permission {
  key         String  @id @db.VarChar(64)
  description String  @db.VarChar(200)
  grantable   Boolean

  grants UserPermissionGrant[]

  @@map("permissions")
}

enum GrantEffect {
  ALLOW
  DENY
}

/// Per-user adjustment of a staff role's default permissions.
model UserPermissionGrant {
  userId        String      @map("user_id") @db.Uuid
  permissionKey String      @map("permission_key") @db.VarChar(64)
  effect        GrantEffect
  grantedById   String?     @map("granted_by_id") @db.Uuid
  reason        String      @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation("GrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("GrantGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([userId, permissionKey])
  @@map("user_permission_grants")
}

enum AuthMethod {
  PASSWORD
  EMAIL_CODE
  /// WebAuthn assertion from a registered platform authenticator (§4.5).
  BIOMETRIC
}

/// A signed-in device. Refresh tokens rotate on every use; only hashes are stored.
model AuthSession {
  id                   String     @id @default(uuid(7)) @db.Uuid
  userId               String     @map("user_id") @db.Uuid
  method               AuthMethod
  /// SHA-256 of the current refresh token id.
  currentRefreshHash   String     @map("current_refresh_hash") @db.Char(64)
  /// SHA-256 of the previous refresh token id, accepted briefly after a rotation.
  previousRefreshHash  String?    @map("previous_refresh_hash") @db.Char(64)
  rotatedAt            DateTime?  @map("rotated_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt           DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt            DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokeReason         String?    @map("revoke_reason") @db.VarChar(64)
  ip                   String?    @db.VarChar(64)
  userAgent            String?    @map("user_agent") @db.VarChar(512)
  /// The biometric credential that opened the session; revoking it ends the session.
  webauthnCredentialId String?    @map("webauthn_credential_id") @db.Uuid

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  webauthnCredential WebAuthnCredential? @relation(fields: [webauthnCredentialId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([webauthnCredentialId])
  @@map("auth_sessions")
}

enum ChallengePurpose {
  LOGIN
  PASSWORD_RESET
  SIGNUP
}

/// Emailed one-time codes (first login, password recovery, signup). Keyed by the
/// email address, because a code can be sent before any account exists (first
/// login of an imported student, §4.3; signup, §4.2). Only an HMAC of the code is stored.
model AuthChallenge {
  id          String           @id @default(uuid(7)) @db.Uuid
  /// Normalized (lowercase) recipient address.
  email       String           @db.VarChar(254)
  /// The account the code was issued for, when one existed at the time.
  userId      String?          @map("user_id") @db.Uuid
  purpose     ChallengePurpose
  codeHash    String           @map("code_hash") @db.Char(64)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  attempts    Int              @default(0)
  maxAttempts Int              @map("max_attempts")
  consumedAt  DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  requestIp   String?          @map("request_ip") @db.VarChar(64)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId])
  @@map("auth_challenges")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

/// Append-only record of security-sensitive and administrative actions (§15).
/// UPDATE/DELETE/TRUNCATE are rejected by a database trigger. Actor fields are
/// snapshots, deliberately without foreign keys, so history survives account changes.
model AuditLog {
  id           BigInt       @id @default(autoincrement())
  occurredAt   DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId      String?      @map("actor_id") @db.Uuid
  actorName    String?      @map("actor_name") @db.VarChar(200)
  actorRole    Role?        @map("actor_role")
  action       String       @db.VarChar(100)
  resourceType String       @map("resource_type") @db.VarChar(64)
  resourceId   String?      @map("resource_id") @db.VarChar(64)
  outcome      AuditOutcome
  reason       String?      @db.VarChar(500)
  before       Json?
  after        Json?
  metadata     Json?
  ip           String?      @db.VarChar(64)
  userAgent    String?      @map("user_agent") @db.VarChar(512)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

/**
 * ═══════════════════════════ Phase 2 ═══════════════════════════
 */

/// A training group (§5). Names are unique ignoring case and spacing (SQL index).
/// Archived groups keep their history but accept no members.
model TrainingGroup {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy      User?              @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships    GroupMembership[]
  scheduleGroups ScheduleGroup[]
  visitGroups    VisitGroup[]
  attendance     AttendanceRecord[]

  @@map("training_groups")
}

enum MembershipSource {
  MANUAL
  IMPORT
  VERIFICATION
}

/// A student's membership in a group over time. At most ONE active membership
/// (`endedAt IS NULL`) per student — enforced by a partial unique index (§5, §16.1).
/// Ended memberships are history and cannot be modified (trigger).
model GroupMembership {
  id           String           @id @default(uuid(7)) @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  groupId      String           @map("group_id") @db.Uuid
  source       MembershipSource
  startedAt    DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime?        @map("ended_at") @db.Timestamptz(3)
  assignedById String?          @map("assigned_by_id") @db.Uuid
  endedById    String?          @map("ended_by_id") @db.Uuid

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group      TrainingGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignedBy User?          @relation("MembershipAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  endedBy    User?          @relation("MembershipEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([groupId, endedAt])
  @@index([studentId, startedAt])
  @@map("group_memberships")
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  DISCARDED
}

/// One uploaded spreadsheet (§4.1). `rows` holds the normalized cell values; the
/// plan (create/update/unchanged/error per row) is recomputed against the live
/// database for every preview and again inside the commit transaction.
model StudentImport {
  id             String       @id @default(uuid(7)) @db.Uuid
  status         ImportStatus @default(PREVIEW)
  fileName       String       @map("file_name") @db.VarChar(255)
  fileSize       Int          @map("file_size")
  fileSha256     String       @map("file_sha256") @db.Char(64)
  /// Object path in the private `student-imports` bucket (null when Storage is not configured).
  storagePath    String?      @map("storage_path") @db.VarChar(512)
  rows           Json
  ignoredColumns Json         @map("ignored_columns")
  createdById    String?      @map("created_by_id") @db.Uuid
  createdByName  String       @map("created_by_name") @db.VarChar(200)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  committedAt    DateTime?    @map("committed_at") @db.Timestamptz(3)
  committedById  String?      @map("committed_by_id") @db.Uuid
  discardedAt    DateTime?    @map("discarded_at") @db.Timestamptz(3)
  /// Plan counts at the last preview / at commit.
  summary        Json
  /// Counts of what the commit actually did.
  result         Json?

  createdBy   User? @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  committedBy User? @relation("ImportCommittedBy", fields: [committedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("student_imports")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum VerificationIssue {
  NO_RECORD
  SEAT_ALREADY_LINKED
  DETAILS_MISMATCH
  EMAIL_ON_OTHER_RECORD
}

/// §4.2 Case B: a verified-email signup that did not match an imported record.
/// The account stays PENDING_VERIFICATION (no access to academic data) until a
/// reviewer links it to a record or creates one. One open request per account.
model StudentVerificationRequest {
  id              String            @id @default(uuid(7)) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  seatNumber      String            @map("seat_number") @db.VarChar(20)
  firstName       String            @map("first_name") @db.VarChar(60)
  fatherName      String            @map("father_name") @db.VarChar(60)
  grandfatherName String            @map("grandfather_name") @db.VarChar(60)
  familyName      String            @map("family_name") @db.VarChar(60)
  fullName        String            @map("full_name") @db.VarChar(200)
  issue           VerificationIssue
  status          RequestStatus     @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz(3)
  decidedById     String?           @map("decided_by_id") @db.Uuid
  decisionReason  String?           @map("decision_reason") @db.VarChar(500)
  /// The record the account was linked to (or created) on approval.
  studentId       String?           @map("student_id") @db.Uuid

  user      User            @relation("VerificationAccount", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?           @relation("VerificationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("student_verification_requests")
}

/// §4.4: a student's request to change protected identity fields (name parts,
/// seat number). `current` is a snapshot at submission, `proposed` only the
/// changed fields. Applied atomically on approval. One open request per student.
model ProfileChangeRequest {
  id             String        @id @default(uuid(7)) @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  requestedById  String?       @map("requested_by_id") @db.Uuid
  status         RequestStatus @default(PENDING)
  current        Json
  proposed       Json
  note           String        @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(3)
  decidedById    String?       @map("decided_by_id") @db.Uuid
  decisionReason String?       @map("decision_reason") @db.VarChar(500)

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User?          @relation("ProfileChangeRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?          @relation("ProfileChangeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([studentId, createdAt])
  @@map("profile_change_requests")
}

/**
 * ═══════════════════════════ Phase 3 ═══════════════════════════
 */

/// Training program settings (§6.1, §8.1, §11). Exactly one program is current
/// (partial unique index). Defaults (12 weeks, 2 absences, 15/15/60 minutes) are
/// only pre-filled by the settings form — every value here is configurable.
/// Timing values are copied into each visit when it is created (§8.1).
model TrainingProgram {
  id                   String            @id @default(uuid(7)) @db.Uuid
  name                 String            @db.VarChar(200)
  startDate            DateTime          @map("start_date") @db.Date
  durationWeeks        Int               @map("duration_weeks")
  /// IANA zone of every wall-clock date/time in the program (§16.2).
  timeZone             String            @default("Africa/Cairo") @map("time_zone") @db.VarChar(64)
  checkInOpensMinutes  Int               @map("check_in_opens_minutes")
  graceMinutes         Int               @map("grace_minutes")
  checkInClosesMinutes Int               @map("check_in_closes_minutes")
  allowedAbsences      Int               @map("allowed_absences")
  /// §7.2 fallback for students without an enrolled biometric credential.
  biometricFallback    BiometricFallback @default(ALLOW_UNVERIFIED) @map("biometric_fallback")
  geolocationPolicy    GeolocationPolicy @default(REQUIRED) @map("geolocation_policy")
  isCurrent            Boolean           @default(true) @map("is_current")
  createdById          String?           @map("created_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy  User?               @relation("ProgramCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  schedules  TrainingSchedule[]
  exceptions ScheduleException[]
  visits     TrainingVisit[]

  @@map("training_programs")
}

/// A recurring weekly schedule (§6.1, §11.2): the definition only. Its sessions
/// are materialized as `training_visits` rows (`schedule_id` + `occurrence_date`),
/// so a single occurrence can be changed without altering the definition.
model TrainingSchedule {
  id           String    @id @default(uuid(7)) @db.Uuid
  programId    String    @map("program_id") @db.Uuid
  title        String    @db.VarChar(200)
  /// 0 = Sunday … 6 = Saturday.
  weekdays     Int[]     @db.SmallInt
  startTime    DateTime  @map("start_time") @db.Time(0)
  endTime      DateTime? @map("end_time") @db.Time(0)
  startsOn     DateTime  @map("starts_on") @db.Date
  endsOn       DateTime  @map("ends_on") @db.Date
  locationName String?   @map("location_name") @db.VarChar(200)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(3)
  endedById    String?   @map("ended_by_id") @db.Uuid
  endReason    String?   @map("end_reason") @db.VarChar(500)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  program    TrainingProgram     @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdBy  User?               @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  endedBy    User?               @relation("ScheduleEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  groups     ScheduleGroup[]
  visits     TrainingVisit[]
  exceptions ScheduleException[]

  @@index([programId, endedAt])
  @@map("training_schedules")
}

/// Groups a recurring schedule applies to (§6.1 group-specific schedules).
model ScheduleGroup {
  scheduleId String @map("schedule_id") @db.Uuid
  groupId    String @map("group_id") @db.Uuid

  schedule TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  group    TrainingGroup    @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([scheduleId, groupId])
  @@index([groupId])
  @@map("schedule_groups")
}

/// A day without training (§6.1): for one schedule, or for every schedule when
/// `scheduleId` is null. The sessions it cancelled point back to it, so removing
/// the exception restores exactly those sessions.
model ScheduleException {
  id          String   @id @default(uuid(7)) @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  date        DateTime @db.Date
  scheduleId  String?  @map("schedule_id") @db.Uuid
  reason      String   @db.VarChar(500)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  program         TrainingProgram   @relation(fields: [programId], references: [id], onDelete: Restrict)
  schedule        TrainingSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("ExceptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledVisits TrainingVisit[]

  @@index([programId, date])
  @@map("schedule_exceptions")
}

enum VisitStatus {
  SCHEDULED
  CANCELLED
}

/// A training visit (§6.3): one-off, or one occurrence of a recurring schedule.
/// `date` + `startTime` are wall-clock values in the program's time zone; the UTC
/// instants `startsAt`/`endsAt` are derived from them by the API (§16.2).
model TrainingVisit {
  id                     String      @id @default(uuid(7)) @db.Uuid
  programId              String      @map("program_id") @db.Uuid
  scheduleId             String?     @map("schedule_id") @db.Uuid
  occurrenceDate         DateTime?   @map("occurrence_date") @db.Date
  /// Edited individually: later schedule changes leave it alone.
  detached               Boolean     @default(false)
  title                  String      @db.VarChar(200)
  description            String?
  date                   DateTime    @db.Date
  startTime              DateTime    @map("start_time") @db.Time(0)
  endTime                DateTime?   @map("end_time") @db.Time(0)
  startsAt               DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt                 DateTime?   @map("ends_at") @db.Timestamptz(3)
  locationName           String?     @map("location_name") @db.VarChar(200)
  latitude               Float?
  longitude              Float?
  mapUrl                 String?     @map("map_url") @db.VarChar(2048)
  checkInOpensMinutes    Int         @map("check_in_opens_minutes")
  graceMinutes           Int         @map("grace_minutes")
  checkInClosesMinutes   Int         @map("check_in_closes_minutes")
  timingOverridden       Boolean     @default(false) @map("timing_overridden")
  status                 VisitStatus @default(SCHEDULED)
  cancelReason           String?     @map("cancel_reason") @db.VarChar(500)
  cancelledAt            DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelledById          String?     @map("cancelled_by_id") @db.Uuid
  cancelledByExceptionId String?     @map("cancelled_by_exception_id") @db.Uuid
  createdById            String?     @map("created_by_id") @db.Uuid
  updatedById            String?     @map("updated_by_id") @db.Uuid
  /// Absences were recorded for students without a check-in (§8.3).
  absencesProcessedAt    DateTime?   @map("absences_processed_at") @db.Timestamptz(3)
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  program              TrainingProgram     @relation(fields: [programId], references: [id], onDelete: Restrict)
  schedule             TrainingSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  cancelledByException ScheduleException?  @relation(fields: [cancelledByExceptionId], references: [id], onDelete: SetNull)
  createdBy            User?               @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?               @relation("VisitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy          User?               @relation("VisitCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  groups               VisitGroup[]
  files                VisitFile[]
  attendance           AttendanceRecord[]
  webauthnChallenges   WebAuthnChallenge[]

  @@unique([scheduleId, occurrenceDate])
  @@index([startsAt])
  @@index([date])
  @@map("training_visits")
}

/// Groups a visit concerns (§6.2). Every visit has at least one (deferred trigger).
model VisitGroup {
  visitId String @map("visit_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid

  visit TrainingVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  group TrainingGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([visitId, groupId])
  @@index([groupId, visitId])
  @@map("visit_groups")
}

enum VisitFileKind {
  COVER
  DOCUMENT
}

/// A visit's cover photo (at most one) or attached document, kept in a private
/// bucket and served through short-lived signed links (§16.3).
model VisitFile {
  id           String        @id @default(uuid(7)) @db.Uuid
  visitId      String        @map("visit_id") @db.Uuid
  kind         VisitFileKind
  bucket       String        @db.VarChar(64)
  storagePath  String        @map("storage_path") @db.VarChar(512)
  fileName     String        @map("file_name") @db.VarChar(255)
  contentType  String        @map("content_type") @db.VarChar(127)
  sizeBytes    Int           @map("size_bytes")
  uploadedById String?       @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  visit      TrainingVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation("VisitFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([bucket, storagePath])
  @@index([visitId, kind])
  @@map("visit_files")
}

/// In-app notification (§12). Stores a type and its parameters, not text: each
/// reader sees it in their own language and time zone. `dedupeKey` makes creation
/// idempotent per recipient (retries never duplicate, §12.1).
model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  type        String    @db.VarChar(64)
  data        Json
  link        String?   @db.VarChar(500)
  dedupeKey   String    @map("dedupe_key") @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

/**
 * ═══════════════════════════ Phase 4 ═══════════════════════════
 */

enum BiometricFallback {
  /// Students without a credential may check in; the record is marked unconfirmed.
  ALLOW_UNVERIFIED
  /// Students must enable biometric sign-in before they can check in.
  REQUIRE_BIOMETRIC
}

enum GeolocationPolicy {
  REQUIRED
  OPTIONAL
}

/// A registered platform authenticator (passkey) of one account (§4.5). Only the
/// public key is stored — never biometric data. Owner, credential id and key are
/// immutable (trigger): a credential belongs to the account that enrolled it (§16.1).
model WebAuthnCredential {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// base64url credential id from the authenticator.
  credentialId String    @unique @map("credential_id") @db.VarChar(1024)
  /// COSE public key.
  publicKey    Bytes     @map("public_key")
  signCount    BigInt    @default(0) @map("sign_count")
  transports   String[]
  multiDevice  Boolean   @map("multi_device")
  backedUp     Boolean   @map("backed_up")
  aaguid       String?   @db.VarChar(36)
  name         String    @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById  String?   @map("revoked_by_id") @db.Uuid
  revokeReason String?   @map("revoke_reason") @db.VarChar(500)

  user       User               @relation("CredentialOwner", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy  User?              @relation("CredentialRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  sessions   AuthSession[]
  attendance AttendanceRecord[]

  @@index([userId, revokedAt])
  @@map("webauthn_credentials")
}

enum WebAuthnPurpose {
  REGISTRATION
  AUTHENTICATION
  CHECK_IN
}

/// A single-use WebAuthn challenge (5 minutes). A check-in challenge is bound to
/// one account and one visit, so an assertion cannot be replayed elsewhere.
model WebAuthnChallenge {
  id         String          @id @default(uuid(7)) @db.Uuid
  purpose    WebAuthnPurpose
  challenge  String          @db.VarChar(128)
  userId     String?         @map("user_id") @db.Uuid
  visitId    String?         @map("visit_id") @db.Uuid
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?       @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  visit TrainingVisit? @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum AttendanceSource {
  QR
  MANUAL
  AUTOMATIC
}

/// One effective attendance record per student per visit (§8.5, §16.1). The group
/// is the one the student attended under and must be one of the visit's groups.
/// Corrections update the record; the audit log keeps every previous state (§8.4).
model AttendanceRecord {
  id                String           @id @default(uuid(7)) @db.Uuid
  visitId           String           @map("visit_id") @db.Uuid
  studentId         String           @map("student_id") @db.Uuid
  groupId           String           @map("group_id") @db.Uuid
  status            AttendanceStatus
  /// Whole minutes after the grace period (§8.2); 0 unless LATE.
  minutesLate       Int              @default(0) @map("minutes_late")
  checkedInAt       DateTime?        @map("checked_in_at") @db.Timestamptz(3)
  source            AttendanceSource
  biometricVerified Boolean          @default(false) @map("biometric_verified")
  credentialId      String?          @map("credential_id") @db.Uuid
  latitude          Float?
  longitude         Float?
  accuracyMeters    Float?           @map("accuracy_meters")
  distanceMeters    Int?             @map("distance_meters")
  correctedById     String?          @map("corrected_by_id") @db.Uuid
  correctedAt       DateTime?        @map("corrected_at") @db.Timestamptz(3)
  correctionReason  String?          @map("correction_reason") @db.VarChar(500)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  visit       TrainingVisit       @relation(fields: [visitId], references: [id], onDelete: Restrict)
  student     StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  group       TrainingGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  credential  WebAuthnCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  correctedBy User?               @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)

  @@unique([visitId, studentId])
  @@index([studentId])
  @@index([groupId, status])
  @@map("attendance_records")
}
