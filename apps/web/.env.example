# apps/web environment — copy to apps/web/.env.local for local development.
# The web app deliberately receives NO backend secrets; it only needs the API URL.
# The full variable list (API + web) is documented in the repo-root .env.example.

# Public base URL of the NestJS API (inlined into the client bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000
