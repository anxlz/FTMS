# apps/web environment — copy to apps/web/.env.local for local development.
# The web app receives no database or service credentials: only the API URL and
# the one secret it shares with the API (BFF_SHARED_SECRET).
# The full variable list (API + web) is documented in the repo-root .env.example.

# Base URL of the NestJS API. Only the web SERVER calls the API (the browser never
# does), so this is read at runtime. API_URL, if set, takes precedence.
NEXT_PUBLIC_API_URL=http://localhost:4000
# API_URL=

# Same value as the API's BFF_SHARED_SECRET. Server-only: lets the API trust the
# browser IP the web server forwards, so rate limits apply per user, not per server.
BFF_SHARED_SECRET=
