# ─────────────────────────────────────────────────────────────────────────────
# FTMS — environment variables (master prompt §2)
#
# Copy to `.env` at the repo root (read by apps/api and the Prisma CLI) and fill
# in real values. NEVER commit `.env`. No real secret appears in this file.
#
# The web app reads only its API URL and BFF_SHARED_SECRET, from
# apps/web/.env.local (see apps/web/.env.example) — no database or service
# credential ever reaches the web process, and nothing secret reaches a browser.
#
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are required in EVERY environment:
# sign-in cannot work without them. Outside production the other credentials
# may stay blank: the API still boots, reports them as `not_configured` on
# GET /health/ready, and logs emails instead of sending them. With
# NODE_ENV=production every credential below is required and the API refuses to
# start without them.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# Local API port (Vercel ignores this).
PORT=4000

# ── Database: Supabase Postgres (Project Settings → Database → Connect) ──────
# Runtime connection used by the API. On Vercel use the TRANSACTION pooler
# (port 6543), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Migrations only (`pnpm db:deploy`). Use the SESSION pooler (port 5432) or the
# direct connection — the transaction pooler cannot run `prisma migrate`.
# Falls back to DATABASE_URL when empty (fine for a local Postgres).
DIRECT_URL=

# ── Supabase Storage (Project Settings → API) ──────────────────────────────
SUPABASE_URL=
# Server-side only. Bypasses Row Level Security — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only if a client-side Supabase call is ever needed (none in Phase 0).
SUPABASE_ANON_KEY=

# ── Upstash Redis (console.upstash.com → database → REST API) ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email: Gmail SMTP via Nodemailer ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ST22425244@agr.asu.edu.eg
# Gmail App Password for SMTP_USER — placeholder only, never fabricate.
# Requires 2-Step Verification on the account. Check it with:
#   pnpm --filter @ftms/api mail:verify
SMTP_PASS=

# ── Signing secrets ─────────────────────────────────────────────────────────
# At least 32 characters each; generate each with:  openssl rand -base64 48
# Access and refresh secrets are required everywhere and must differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# QR attendance tokens — consumed from Phase 4; validated now.
QR_HMAC_SECRET=

# ── Web ↔ API trust ─────────────────────────────────────────────────────────
# Shared secret between the web SERVER and the API (set the same value in
# apps/web/.env.local and on both Vercel projects; never in a browser). Lets the
# API trust the client IP the web server forwards, so rate limits apply per
# person instead of per web server. At least 32 characters.
BFF_SHARED_SECRET=
# Public URL of the web app — used for links in emails (invitations).
WEB_APP_URL=http://localhost:3000

# ── Display time zone (storage is always UTC) ───────────────────────────────
APP_TIMEZONE=Africa/Cairo

# ── Web (also set this in apps/web/.env.local and on the web Vercel project) ─
# Only the web server calls the API (the browser never does). API_URL, if set
# there, takes precedence — useful when the server reaches the API privately.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Branding (used only by `pnpm icons`) ───────────────────────────────────
# Leave empty to derive icons from the committed official logo at
# assets/branding/source/agr-logo.png. Set to an image URL to download a
# replacement source first (it overwrites the committed file for review).
APP_ICON_SOURCE_URL=
