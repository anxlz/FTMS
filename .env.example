# ─────────────────────────────────────────────────────────────────────────────
# FTMS — environment variables (master prompt §2)
#
# Copy to `.env` at the repo root (read by apps/api and the Prisma CLI) and fill
# in real values. NEVER commit `.env`. No real secret appears in this file.
#
# The web app reads only NEXT_PUBLIC_API_URL, from apps/web/.env.local
# (see apps/web/.env.example) — backend secrets never reach the web process.
#
# Outside production, service credentials may stay blank: the API still boots,
# reports them as `not_configured` on GET /health/ready, and logs emails instead
# of sending them. With NODE_ENV=production every credential below is required
# and the API refuses to start without them.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# Local API port (Vercel ignores this).
PORT=4000

# ── Database: Supabase Postgres (Project Settings → Database → Connect) ──────
# Runtime connection used by the API. On Vercel use the TRANSACTION pooler
# (port 6543), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Migrations only (`pnpm db:deploy`). Use the SESSION pooler (port 5432) or the
# direct connection — the transaction pooler cannot run `prisma migrate`.
# Falls back to DATABASE_URL when empty (fine for a local Postgres).
DIRECT_URL=

# ── Supabase Storage (Project Settings → API) ──────────────────────────────
SUPABASE_URL=
# Server-side only. Bypasses Row Level Security — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only if a client-side Supabase call is ever needed (none in Phase 0).
SUPABASE_ANON_KEY=

# ── Upstash Redis (console.upstash.com → database → REST API) ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email: Gmail SMTP via Nodemailer ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ST22425244@agr.asu.edu.eg
# Gmail App Password for SMTP_USER — placeholder only, never fabricate.
# Requires 2-Step Verification on the account. Check it with:
#   pnpm --filter @ftms/api mail:verify
SMTP_PASS=

# ── Signing secrets (consumed from Phase 1 / Phase 4; validated now) ────────
# At least 32 characters each; generate with:  openssl rand -base64 48
# Access and refresh secrets must differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QR_HMAC_SECRET=

# ── Display time zone (storage is always UTC) ───────────────────────────────
APP_TIMEZONE=Africa/Cairo

# ── Web (also set this in apps/web/.env.local and on the web Vercel project) ─
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Branding (used only by `pnpm icons`) ───────────────────────────────────
# Leave empty to derive icons from the committed official logo at
# assets/branding/source/agr-logo.png. Set to an image URL to download a
# replacement source first (it overwrites the committed file for review).
APP_ICON_SOURCE_URL=
