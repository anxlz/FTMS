{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "APP_TIMEZONE"],
  "globalPassThroughEnv": [
    "PRISMA_*",
    "PLAYWRIGHT_*",
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.test.ts", "!test/**", "!.env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_API_URL"]
    },
    "prisma:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/prisma/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "lint": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "test": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": []
    },
    "@ftms/api#test": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/apps/web/.env.example",
        "$TURBO_ROOT$/docs/environment.md"
      ]
    },
    "@ftms/web#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/branding/**"]
    },
    "@ftms/mobile#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/lib/native.ts",
        "$TURBO_ROOT$/apps/web/messages/**",
        "$TURBO_ROOT$/assets/branding/generated/android/**"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DIRECT_URL"]
    },
    "dev": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "DIRECT_URL",
        "SUPABASE_*",
        "UPSTASH_*",
        "SMTP_*",
        "JWT_*",
        "QR_HMAC_SECRET",
        "NEXT_PUBLIC_API_URL",
        "BFF_SHARED_SECRET",
        "WEB_APP_URL",
        "UNIVERSITY_EMAIL_DOMAINS",
        "API_URL"
      ]
    },
    "@ftms/web#test:e2e": {
      "dependsOn": ["build", "@ftms/api#build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
